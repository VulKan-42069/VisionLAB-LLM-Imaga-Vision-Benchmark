import { Theme, Metrics } from "theme.slint";
import { Api } from "api.slint";
import { AppButton, BtnKind } from "widgets.slint";
import { TextEdit } from "std-widgets.slint";

export component ConfirmOverlay inherits Rectangle {
    background: Theme.colors.background-overlay;

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { Api.confirm-cancel(); }
    }

    card := Rectangle {
        width: min(420px, parent.width - 48px);
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        background: Theme.colors.surface-primary;
        border-width: 1px;
        border-color: Theme.colors.border-primary;
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 10px;

        body := VerticalLayout {
            padding: 22px;
            spacing: 10px;
            alignment: start;

            Text {
                text: Api.confirm-title;
                color: Theme.colors.text-primary;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: Api.confirm-message;
                color: Theme.colors.text-secondary;
                font-size: 13px;
                wrap: word-wrap;
            }
            if Api.confirm-detail != "": Text {
                text: Api.confirm-detail;
                color: Theme.colors.text-tertiary;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-top: 8px;
                spacing: 8px;
                alignment: end;
                AppButton {
                    text: "Cancel";
                    clicked => { Api.confirm-cancel(); }
                }
                AppButton {
                    text: Api.confirm-action;
                    kind: Api.confirm-danger ? BtnKind.danger : BtnKind.primary;
                    clicked => { Api.confirm-ok(); }
                }
            }
        }
    }
}

export component ErrorOverlay inherits Rectangle {
    background: Theme.colors.background-overlay;
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { Api.error-dismiss(); }
    }

    card := Rectangle {
        width: min(480px, parent.width - 48px);
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 14px;
        background: Theme.colors.surface-primary;
        border-width: 1px;
        border-color: Theme.colors.status-fail.transparentize(0.5);
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 10px;

        body := VerticalLayout {
            padding: 22px;
            spacing: 10px;
            alignment: start;

            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    width: 20px;
                    alignment: center;
                    Image {
                        source: @image-url("../assets/alert.svg");
                        width: 18px;
                        height: 18px;
                        colorize: Theme.colors.status-fail;
                        image-fit: contain;
                    }
                }
                Text {
                    text: Api.error-title;
                    color: Theme.colors.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Text {
                text: Api.error-message;
                color: Theme.colors.text-secondary;
                font-size: 13px;
                wrap: word-wrap;
            }
            if Api.error-detail != "": TextEdit {
                text: Api.error-detail;
                read-only: true;
                wrap: word-wrap;
                height: 120px;
                font-family: "Cascadia Mono";
                font-size: 11px;
            }
            HorizontalLayout {
                alignment: end;
                AppButton {
                    text: Api.error-action;
                    kind: BtnKind.primary;
                    clicked => { Api.error-dismiss(); }
                }
            }
        }
    }
}

export component ToastView inherits Rectangle {
    width: 320px;
    height: row.preferred-height;
    border-radius: 12px;
    background: Theme.colors.surface-primary;
    border-width: 1px;
    border-color: Theme.colors.border-primary;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000055;
    drop-shadow-offset-y: 6px;
    opacity: Api.toast-visible ? 1 : 0;
    animate opacity { duration: 180ms; }

    row := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        alignment: center;

        VerticalLayout {
            width: 18px;
            alignment: center;
            Image {
                source: @image-url("../assets/check.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.colors.status-pass;
                image-fit: contain;
            }
        }
        Text {
            text: Api.toast-text;
            color: Theme.colors.text-primary;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        TouchArea {
            width: 22px;
            height: 22px;
            mouse-cursor: pointer;
            clicked => { Api.toast-dismiss(); }
            Image {
                x: (parent.width - 14px) / 2;
                y: (parent.height - 14px) / 2;
                source: @image-url("../assets/x.svg");
                width: 14px;
                height: 14px;
                colorize: Theme.colors.text-tertiary;
                image-fit: contain;
            }
        }
    }
}
