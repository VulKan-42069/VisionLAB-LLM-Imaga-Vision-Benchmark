import { Theme, Metrics } from "theme.slint";
import { Api } from "api.slint";
import { AppButton, IconButton, Pill, LegendBar, Banner, SeekBar, BtnKind, SectionLabel, MetricTile, EmptyState, ToolbarLabel, ZoomCanvas } from "widgets.slint";
import { ComboBox, LineEdit, Spinner, TextEdit } from "std-widgets.slint";

export component StudioView inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        if Api.show-connect-banner: Banner {
            text: "Connect a provider in Settings. Cloud keys stay in Windows Credential Manager. Ollama needs no key.";
            action-text: "Open Settings";
            action => { Api.goto-screen(3); }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Rectangle {
                background: Theme.colors.surface-primary;
                border-radius: 0px;
                border-width: 1px;
                border-color: Theme.colors.border-primary;
                horizontal-stretch: 3;
                min-width: 0px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 10px;
                        SectionLabel { caption: "Annotated image"; }
                        if Api.media-label != "": Text {
                            text: Api.media-label;
                            color: Theme.colors.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if Api.downscale-notice != "": Pill {
                            text: Api.downscale-notice;
                            tone: Theme.colors.status-warning;
                        }
                    }

                    Rectangle {
                        background: Theme.colors.background-secondary;
                        border-radius: Metrics.r-md;
                        border-width: 1px;
                        border-color: Theme.colors.border-primary;
                        vertical-stretch: 1;
                        min-width: 0px;
                        clip: true;

                        if !Api.has-media: VerticalLayout {
                            width: 100%;
                            height: 100%;
                            alignment: center;
                            EmptyState {
                                title: "No media loaded";
                                body: "Use Open image or Open video in the bar below, then seek a video to the frame you want to test.";
                            }
                        }

                        if Api.has-media: ZoomCanvas {
                            source: Api.canvas-image;
                            width: 100%;
                            height: 100%;
                        }

                        if Api.is-running: Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            background: Theme.colors.background-overlay;
                            VerticalLayout {
                                width: 100%;
                                height: 100%;
                                alignment: center;
                                spacing: 10px;
                                HorizontalLayout {
                                    alignment: center;
                                    Spinner {
                                        width: 28px;
                                        height: 28px;
                                        indeterminate: true;
                                    }
                                }
                                Text {
                                    text: "Running vision test...";
                                    color: white;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    if Api.legend.length > 0: LegendBar {
                        items: Api.legend;
                    }

                    if Api.media-meta != "": Text {
                        text: Api.media-meta;
                        color: Theme.colors.text-secondary;
                        font-size: 12px;
                    }
                }
            }

            Rectangle {
                background: Theme.colors.surface-primary;
                border-radius: 0px;
                border-width: 1px;
                border-color: Theme.colors.border-primary;
                horizontal-stretch: 2;
                min-width: 360px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        SectionLabel { caption: "Results"; }
                        Rectangle { horizontal-stretch: 1; }
                        if Api.last-verdict == "pass": Pill { text: "PASS"; tone: Theme.colors.status-pass; }
                        if Api.last-verdict == "fail": Pill { text: "FAIL"; tone: Theme.colors.status-fail; }
                        if Api.last-verdict == "pending": Pill { text: "UNGRADED"; tone: Theme.colors.status-warning; }
                    }

                    Rectangle {
                        background: Theme.colors.background-secondary;
                        border-radius: Metrics.r-md;
                        border-width: 1px;
                        border-color: Theme.colors.border-primary;
                        vertical-stretch: 1;
                        clip: true;

                        if !Api.has-result: VerticalLayout {
                            width: 100%;
                            height: 100%;
                            alignment: center;
                            EmptyState {
                                title: "Waiting for a run";
                                body: Api.result-summary;
                            }
                        }

                        if Api.has-result: VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            TextEdit {
                                text: Api.raw-json;
                                read-only: true;
                                wrap: no-wrap;
                                font-family: "Cascadia Mono";
                                font-size: 11px;
                                vertical-stretch: 1;
                            }
                            if Api.raw-json-clipped: Text {
                                text: "Preview only. Copy has the full JSON.";
                                color: Theme.colors.text-tertiary;
                                font-size: 11px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        MetricTile {
                            label: "Latency";
                            value: Api.latency-text == "" ? "n/a" : Api.latency-text;
                        }
                        MetricTile {
                            label: "Tokens";
                            value: Api.tokens-text == "" ? "n/a" : Api.tokens-text;
                        }
                        MetricTile {
                            label: "Cost";
                            value: Api.cost-text == "" ? "n/a" : Api.cost-text;
                        }
                    }

                    LineEdit {
                        placeholder-text: "Notes saved with the verdict";
                        text <=> Api.notes-text;
                        edited(t) => { Api.notes-changed(t); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            text: "Pass";
                            icon: @image-url("../assets/check.svg");
                            kind: BtnKind.success;
                            enabled: Api.grade-enabled;
                            min-w: 92px;
                            clicked => { Api.grade-pass(); }
                        }
                        AppButton {
                            text: "Fail";
                            icon: @image-url("../assets/x.svg");
                            kind: BtnKind.danger;
                            enabled: Api.grade-enabled;
                            min-w: 92px;
                            clicked => { Api.grade-fail(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        AppButton {
                            text: "Retry";
                            icon: @image-url("../assets/retry.svg");
                            enabled: Api.has-media && !Api.is-running;
                            clicked => { Api.retry-test(); }
                        }
                        AppButton {
                            text: "Copy";
                            icon: @image-url("../assets/copy.svg");
                            enabled: Api.has-result;
                            clicked => { Api.copy-json(); }
                        }
                        AppButton {
                            text: "Clear";
                            icon: @image-url("../assets/trash.svg");
                            enabled: Api.has-result || Api.has-media;
                            clicked => { Api.clear-result(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 44px;
            background: Theme.colors.surface-primary;
            border-radius: Metrics.r-md;
            border-width: 1px;
            border-color: Theme.colors.border-primary;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;

                ToolbarLabel { caption: "Prompt"; }
                LineEdit {
                    text <=> Api.focus-prompt;
                    placeholder-text: Api.task-index == 0 ? "Optional. Example: only classify as cat or dog."
                        : Api.task-index == 1 ? "Optional. Example: only detect people and cars."
                        : Api.task-index == 2 ? "Optional. Example: only segment red apples."
                        : Api.task-index == 3 ? "Optional. Example: only face keypoints."
                        : "Optional. Example: only read the price tags.";
                    horizontal-stretch: 1;
                }
            }
        }

        Rectangle {
            height: 52px;
            background: Theme.colors.surface-primary;
            border-radius: Metrics.r-md;
            border-width: 1px;
            border-color: Theme.colors.border-primary;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;

                AppButton {
                    text: "Open image";
                    icon: @image-url("../assets/folder-open.svg");
                    clicked => { Api.open-image(); }
                }
                AppButton {
                    text: "Open video";
                    icon: @image-url("../assets/film.svg");
                    clicked => { Api.open-video(); }
                }

                Rectangle {
                    width: 1px;
                    height: 20px;
                    background: Theme.colors.border-primary;
                }

                AppButton {
                    text: Api.is-running ? "Running..." : "Run";
                    icon: @image-url("../assets/play.svg");
                    kind: BtnKind.primary;
                    min-w: 108px;
                    enabled: Api.run-enabled && !Api.is-running;
                    clicked => { Api.run-test(); }
                }
                AppButton {
                    text: "Export";
                    icon: @image-url("../assets/download.svg");
                    enabled: Api.has-result;
                    clicked => { Api.export-result(); }
                }

                Rectangle { horizontal-stretch: 1; }

                ToolbarLabel { caption: "Model"; }
                ComboBox {
                    width: 248px;
                    model: Api.model-names;
                    current-index <=> Api.model-index;
                    selected(v) => { Api.select-model(self.current-index); }
                }
                ToolbarLabel { caption: "Task"; }
                ComboBox {
                    width: 196px;
                    model: Api.task-names;
                    current-index <=> Api.task-index;
                    selected(v) => { Api.select-task(self.current-index); }
                }
            }
        }

        if Api.is-video: Rectangle {
            height: 52px;
            background: Theme.colors.surface-primary;
            border-radius: Metrics.r-md;
            border-width: 1px;
            border-color: Theme.colors.border-primary;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;

                IconButton {
                    icon: @image-url("../assets/chevron-left.svg");
                    clicked => { Api.video-step(-1); }
                }
                IconButton {
                    icon: Api.video-playing ? @image-url("../assets/pause.svg") : @image-url("../assets/play.svg");
                    clicked => { Api.video-play-toggle(); }
                }
                IconButton {
                    icon: @image-url("../assets/stop.svg");
                    clicked => { Api.video-stop(); }
                }
                IconButton {
                    icon: @image-url("../assets/chevron-right.svg");
                    clicked => { Api.video-step(1); }
                }

                SeekBar {
                    value: Api.video-position;
                    changed(v) => { Api.video-position = v; }
                    released(v) => { Api.video-seek(v); }
                }

                Text {
                    text: Api.video-time;
                    color: Theme.colors.text-secondary;
                    font-size: 12px;
                    font-family: "Cascadia Mono";
                    vertical-alignment: center;
                    min-width: 90px;
                }
                Text {
                    text: Api.video-frame;
                    color: Theme.colors.text-tertiary;
                    font-size: 12px;
                    vertical-alignment: center;
                    min-width: 110px;
                }
            }
        }
    }
}
